# Postgres connection string. Railway provides this automatically when you
# attach a Postgres plugin to your project -- copy it from Railway's
# Variables tab. For local dev, point this at a local Postgres instance.
DATABASE_URL=postgres://user:password@localhost:5432/lmu_coach

# From Discord Developer Portal -> your application -> OAuth2 -> General
DISCORD_CLIENT_ID=1530657771672961205
DISCORD_CLIENT_SECRET=paste_your_client_secret_here

# Must exactly match a redirect registered in Discord's OAuth2 settings.
# Use the localhost one for local dev; add the Railway URL there too once
# deployed, and switch this value for production.
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Secret used to sign the login cookie. Any long random string (e.g. run
# `openssl rand -hex 32`). REQUIRED in production (NODE_ENV=production) --
# the site refuses to log anyone in without it. In development it may be
# left unset (DISCORD_CLIENT_SECRET is used instead). Changing it logs
# everyone out.
SESSION_SECRET=

# Your Discord server's ID (Copy Server ID, with Developer Mode on) --
# this is the membership gate.
DISCORD_GUILD_ID=1528349016931172503

# Comma-separated Discord user IDs that get the "coach" role on signup/
# login -- everyone else who passes the membership gate is a "student".
# Get your own Discord user ID the same way as the server ID (right-click
# your own name/avatar -> Copy User ID, with Developer Mode on).
DISCORD_COACH_IDS=your_discord_user_id_here

# Shown to users who try to sign up without being in the Discord.
DISCORD_INVITE_URL=https://discord.gg/gTqcAhrnkU

NODE_ENV=development

# Optional. A webhook for the Discord channel that should carry the lap
# leaderboards (channel settings -> Integrations -> Webhooks -> New
# Webhook -> Copy Webhook URL). One message per track, top five per car
# class, edited in place as faster laps come in. Leave unset to disable.
DISCORD_LEADERBOARD_WEBHOOK_URL=

# Optional. The bot token (Developer Portal -> your application -> Bot ->
# Reset Token) turns on reaction roles, managed from /coach/discord. The bot
# needs the Manage Roles, Manage Messages, View Channels, Send Messages, Read
# Message History and Add Reactions permissions. Manage Messages is what lets it
# clear a member's earlier click when they pick a different role, so without it
# a band picker still swaps the roles but leaves the old emoji lit up. Its role
# must sit ABOVE the roles it hands out in Server Settings -> Roles. Never
# commit this value.
DISCORD_BOT_TOKEN=

# Optional. Google OAuth credentials turn on "Connect Google Calendar" on the
# league pages: a member links their Google account once, then every future
# race in a league they've registered for is added to their Google Calendar
# automatically (and removed if the organiser unschedules it). Leave both blank
# to hide the feature entirely. Set up in Google Cloud Console:
#   1. Create a project, enable the "Google Calendar API".
#   2. OAuth consent screen -> External, add the calendar scope.
#   3. Credentials -> Create OAuth client ID -> Web application.
#      Authorized redirect URI must be EXACTLY the callback URL below
#      (for local dev, also add the localhost version).
# Never commit the client secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Where Google sends the member back after they approve. If unset the
# site uses <SITE_URL or DISCORD_REDIRECT origin>/league/calendar/callback, so
# set it explicitly when that guess is wrong. Must match the redirect URI
# registered in the Google Console step above.
GOOGLE_REDIRECT_URI=

# Required to turn on the voice engineer's strategy conversations. The desktop app
# sends a recording, then a question and car readings here, and this server passes
# them to OpenAI. Without a key the routes answer 503, the app falls back to Windows
# speech recognition, and every other feature still works. Set it in Railway's
# Variables tab and never commit the value.
OPENAI_API_KEY=

# Optional. Which chat model answers. Defaults to gpt-4.1-mini.
GRIDLABS_ENGINEER_MODEL=

# Optional. Which model turns one radio recording into words. Defaults to
# gpt-4o-mini-transcribe. Transcription spends none of an account's free
# strategy questions; only an answered question is counted.
GRIDLABS_ASR_MODEL=

# Optional. Free strategy questions per account, counted for the life of the
# account rather than per day, so reinstalling the app can't reset an allowance.
# Defaults to 2, capped at 200, and 0 turns the trial off. Coaches and
# moderators are outside the count entirely, so staff can test without spending
# a member's allowance.
GRIDLABS_ENGINEER_TRIAL_QUESTIONS=
