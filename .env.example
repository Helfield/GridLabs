# Postgres connection string. Railway provides this automatically when you
# attach a Postgres plugin to your project -- copy it from Railway's
# Variables tab. For local dev, point this at a local Postgres instance.
DATABASE_URL=postgres://user:password@localhost:5432/lmu_coach

# From Discord Developer Portal -> your application -> OAuth2 -> General
DISCORD_CLIENT_ID=1530657771672961205
DISCORD_CLIENT_SECRET=paste_your_client_secret_here

# Must exactly match a redirect registered in Discord's OAuth2 settings.
# Use the localhost one for local dev; add the Railway URL there too once
# deployed, and switch this value for production.
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Your Discord server's ID (Copy Server ID, with Developer Mode on) --
# this is the membership gate.
DISCORD_GUILD_ID=1528349016931172503

# Comma-separated Discord user IDs that get the "coach" role on signup/
# login -- everyone else who passes the membership gate is a "student".
# Get your own Discord user ID the same way as the server ID (right-click
# your own name/avatar -> Copy User ID, with Developer Mode on).
DISCORD_COACH_IDS=your_discord_user_id_here

# Shown to users who try to sign up without being in the Discord.
DISCORD_INVITE_URL=https://discord.gg/gTqcAhrnkU

NODE_ENV=development
